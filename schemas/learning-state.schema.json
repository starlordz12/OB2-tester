{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ob2-tester/learning-state.schema.json",
  "title": "OB2 Tester learning state",
  "type": "object",
  "required": ["schemaVersion", "executableSha256", "bestLiveOrbit"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "executableFileName": { "type": "string" },
    "executableSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "verifiedAtUtc": { "type": "string", "format": "date-time" },
    "updatedAtUtc": { "type": "string", "format": "date-time" },
    "bestLiveOrbit": {
      "type": ["object", "null"],
      "properties": {
        "preset": { "enum": ["SRB", "Heavy", "Orbiter"] },
        "craft": { "type": "string" },
        "missionTimeS": { "type": "number", "exclusiveMinimum": 0 },
        "successGate": { "type": "string" },
        "finalAltitudeM": { "type": "number" },
        "finalApoapsisM": { "type": "number" },
        "finalPeriapsisM": { "type": "number" },
        "remainingFuelT": { "type": "number", "minimum": 0 },
        "profile": { "type": "object" },
        "evidenceDirectory": { "type": "string" }
      },
      "required": ["preset", "craft", "missionTimeS", "successGate"]
    },
    "activeProfile": { "type": "object" },
    "lastSessionName": { "type": "string" },
    "lastSessionResults": { "type": "array" },
    "learnedGuards": { "type": "array", "items": { "type": "string" } },
    "liveModuleComparisons": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}

